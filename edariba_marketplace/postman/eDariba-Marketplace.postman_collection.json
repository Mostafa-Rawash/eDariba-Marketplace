{
  "info": {
    "name": "eDariba Marketplace API",
    "description": "Public Marketplace endpoints implemented in edariba_marketplace/api/marketplace/*. Set {{base_url}} to the real site root, e.g. https://your-site.example.com. Accountants/Services/Projects/Metadata/Inquiry are live-ready once this app is installed and migrated. Search/Chat are code-complete and the embed->Qdrant pipeline was verified live end-to-end (2026-10-14) with the real EMBEDDING_API_KEY — they still need the DocTypes migrated with real published records and the key set in the server's site_config.json (never commit it) before they'll return real results instead of empty ones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "accountant_slug", "value": "hesham-elqadi" },
    { "key": "service_slug", "value": "monthly-bookkeeping-sme" },
    { "key": "project_slug", "value": "ecommerce-vat-cleanup" }
  ],
  "item": [
    {
      "name": "Accountants",
      "item": [
        {
          "name": "List accountants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.marketplace.accountants.list_accountants?page=1&page_size=20&sort_by=experience_years&sort_order=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "edariba_marketplace.api.marketplace.accountants.list_accountants"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" },
                { "key": "sort_by", "value": "experience_years" },
                { "key": "sort_order", "value": "desc" },
                { "key": "q", "value": "", "disabled": true },
                { "key": "specialty", "value": "", "disabled": true },
                { "key": "governorate", "value": "القاهرة", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get accountant by slug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.marketplace.accountants.get_accountant?slug={{accountant_slug}}",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "edariba_marketplace.api.marketplace.accountants.get_accountant"],
              "query": [{ "key": "slug", "value": "{{accountant_slug}}" }]
            }
          }
        },
        {
          "name": "Get accountant - not found (404 expected)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.marketplace.accountants.get_accountant?slug=does-not-exist",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "edariba_marketplace.api.marketplace.accountants.get_accountant"],
              "query": [{ "key": "slug", "value": "does-not-exist" }]
            }
          }
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "List services",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.marketplace.services.list_services?page=1&page_size=20&sort_by=price&sort_order=asc",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "edariba_marketplace.api.marketplace.services.list_services"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" },
                { "key": "sort_by", "value": "price" },
                { "key": "sort_order", "value": "asc" },
                { "key": "category", "value": "tax", "disabled": true },
                { "key": "min_price", "value": "500", "disabled": true },
                { "key": "max_price", "value": "5000", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get service by slug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.marketplace.services.get_service?slug={{service_slug}}",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "edariba_marketplace.api.marketplace.services.get_service"],
              "query": [{ "key": "slug", "value": "{{service_slug}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
