          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.marketplace.projects.list_projects?page=1&page_size=20&sort_by=deadline&sort_order=asc",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "edariba_marketplace.api.marketplace.projects.list_projects"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" },
                { "key": "sort_by", "value": "deadline" },
                { "key": "sort_order", "value": "asc" },
                { "key": "category", "value": "tax", "disabled": true },
                { "key": "skills", "value": "لجان الطعن", "disabled": true },
                { "key": "budget_min", "value": "5000", "disabled": true },
                { "key": "budget_max", "value": "30000", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get project by slug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.marketplace.projects.get_project?slug={{project_slug}}",
