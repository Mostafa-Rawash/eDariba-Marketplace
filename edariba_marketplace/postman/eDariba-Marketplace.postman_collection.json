        }
      ]
    },
    {
      "name": "Metadata",
      "item": [
        {
          "name": "Get filter metadata (categories, governorates, ...)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.marketplace.metadata.get_metadata",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "edariba_marketplace.api.marketplace.metadata.get_metadata"]
            }
          }
        }
      ]
    },
    {
      "name": "Search & Chat (verified live; needs EMBEDDING_API_KEY configured server-side)",
      "item": [
        {
          "name": "Unified semantic search",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.marketplace.search.search",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "edariba_marketplace.api.marketplace.search.search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"محتاج محاسب متخصص في الضرائب والفاتورة الإلكترونية في القاهرة\",\n  \"entity_types\": [\"accountant\", \"service\", \"project\"],\n  \"filters\": {\n    \"location\": \"القاهرة\",\n    \"specialty\": [\"الفاتورة الإلكترونية SDK\"]\n  },\n  \"page\": 1,\n  \"page_size\": 10\n}"
            }
          }
        },
        {
          "name": "Chat discovery",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.marketplace.chat.discover",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "edariba_marketplace.api.marketplace.chat.discover"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"عايز محاسب ضرائب في القاهرة\",\n  \"filters\": {},\n  \"page\": 1,\n  \"page_size\": 10\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Inquiry",
      "item": [
        {
          "name": "Submit inquiry (Guest-writable, rate-limited)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.marketplace.inquiry.submit_inquiry",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "edariba_marketplace.api.marketplace.inquiry.submit_inquiry"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"{{accountant_slug}}\",\n  \"requester_name\": \"شركة النيل للتجارة\",\n  \"requester_email\": \"test@example.com\",\n  \"requester_phone\": \"01000000000\",\n  \"inquiry_type\": \"tax_audit\",\n  \"details\": \"استفسار تجريبي عبر Postman.\"\n}"
            }
          }
        }
      ]
    },
