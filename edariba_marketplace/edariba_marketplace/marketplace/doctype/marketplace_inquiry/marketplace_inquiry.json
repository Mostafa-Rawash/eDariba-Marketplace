{
  "doctype": "DocType",
  "name": "Marketplace Inquiry",
  "module": "Marketplace",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "autoname": "hash",
  "naming_rule": "Random",
  "track_changes": 1,
  "engine": "InnoDB",
  "description": "Backs the real 'استفسار مباشر وسري' form in accountant-profile.php (currently rendered with data-edariba-demo-form, i.e. it intentionally does not submit yet). Field names below are copied 1:1 from that form's actual name= attributes, not invented. Fully private: no public read, ever.",
  "fields": [
    {
      "fieldname": "recipient",
      "fieldtype": "Link",
      "options": "Marketplace Profile",
      "label": "Recipient",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "related_service",
      "fieldtype": "Link",
      "options": "Marketplace Service",
      "label": "Related Service",
      "description": "Optional — set when the inquiry originates from a specific service page rather than the profile page."
    },
    {
      "fieldname": "section_break_requester",
      "fieldtype": "Section Break",
      "label": "Requester"
    },
    {
      "fieldname": "requester_name",
      "fieldtype": "Data",
      "label": "Requester Name",
      "reqd": 1,
      "description": "Form field name=\"name\" (id=\"client-name\"): 'الاسم / اسم المنشأة'."
    },
    {
      "fieldname": "requester_email",
      "fieldtype": "Data",
      "options": "Email",
      "label": "Requester Email",
      "reqd": 1,
      "description": "Form field name=\"email\" (id=\"client-email\")."
    },
    {
      "fieldname": "requester_phone",
      "fieldtype": "Data",
      "label": "Requester Phone",
      "reqd": 1,
      "description": "Form field name=\"phone\" (id=\"client-phone\")."
    },
    {
      "fieldname": "column_break_requester",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "inquiry_type",
      "fieldtype": "Select",
      "options": "tax_audit\neinvoice\nannual_return\nconsultation",
      "label": "Inquiry Type",
      "description": "Form field name=\"type\" (id=\"inquiry-type\"); option values copied verbatim from the <select> in accountant-profile.php."
    },
    {
      "fieldname": "details",
      "fieldtype": "Small Text",
      "label": "Details",
      "reqd": 1,
      "description": "Form field name=\"details\" (id=\"case-details\"): 'موجز الاستفسار'."
    },
    {
      "fieldname": "section_break_status",
      "fieldtype": "Section Break",
      "label": "Status"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "New\nContacted\nClosed",
      "default": "New",
      "label": "Status",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "created_at",
      "fieldtype": "Datetime",
      "label": "Created At",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Marketplace Moderator",
      "read": 1,
      "write": 1,
      "create": 0,
      "delete": 0
    },
    {
      "role": "Marketplace Provider",
      "read": 1,
      "write": 1,
      "create": 0,
      "delete": 0,
      "if_owner": 0
    },
    {
      "role": "Guest",
      "read": 0,
      "write": 0,
      "create": 1,
      "delete": 0
    }
  ]
}
