{
  "doctype": "DocType",
  "name": "Marketplace Inquiry",
  "module": "Marketplace",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "autoname": "hash",
  "naming_rule": "Random",
  "track_changes": 1,
  "engine": "InnoDB",
  "description": "A request from a logged-in client to one accountant (Marketplace Profile). Created only through edariba_marketplace.api.workspace.submit_request; users have no DocPerm on it. Fully private.",
  "fields": [
    {
      "fieldname": "recipient",
      "fieldtype": "Link",
      "options": "Marketplace Profile",
      "label": "Recipient",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "related_service",
      "fieldtype": "Link",
      "options": "Marketplace Service",
      "label": "Related Service",
      "description": "Optional — set when the inquiry originates from a specific service page rather than the profile page."
    },
    {
      "fieldname": "section_break_requester",
      "fieldtype": "Section Break",
      "label": "Requester"
    },
    {
      "fieldname": "requester",
      "fieldtype": "Link",
      "options": "User",
      "label": "Requester",
      "reqd": 1,
      "read_only": 1,
      "in_standard_filter": 1,
      "description": "Set from the session by submit_request, never from the client."
    },
    {
      "fieldname": "requester_name",
      "fieldtype": "Data",
      "label": "Requester Name",
      "reqd": 1,
      "description": "Snapshot of the requester's full name at submit time."
    },
    {
      "fieldname": "requester_email",
      "fieldtype": "Data",
      "options": "Email",
      "label": "Requester Email",
      "reqd": 1,
      "description": "Snapshot of the requester's email at submit time."
    },
    {
      "fieldname": "requester_phone",
      "fieldtype": "Data",
      "label": "Requester Phone",
      "description": "Optional contact phone."
    },
    {
      "fieldname": "column_break_requester",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "inquiry_type",
      "fieldtype": "Select",
      "options": "tax_audit\neinvoice\nannual_return\nconsultation",
      "label": "Inquiry Type",
      "description": "Form field name=\"type\" (id=\"inquiry-type\"); option values copied verbatim from the <select> in accountant-profile.php."
    },
    {
      "fieldname": "details",
      "fieldtype": "Small Text",
      "label": "Details",
      "reqd": 1,
      "description": "Form field name=\"details\" (id=\"case-details\"): 'موجز الاستفسار'."
    },
    {
      "fieldname": "section_break_status",
      "fieldtype": "Section Break",
      "label": "Status"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "New\nResponded\nAccepted\nDeclined\nClosed\nCancelled",
      "default": "New",
      "label": "Status",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "read_only": 1
    },
    {
      "fieldname": "created_at",
      "fieldtype": "Datetime",
      "label": "Created At",
      "read_only": 1
    },
    {
      "fieldname": "section_break_response",
      "fieldtype": "Section Break",
      "label": "Response"
    },
    {
      "fieldname": "response",
      "fieldtype": "Small Text",
      "label": "Response",
      "read_only": 1
    },
    {
      "fieldname": "responded_at",
      "fieldtype": "Datetime",
      "label": "Responded At",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Marketplace Moderator",
      "read": 1,
      "write": 1,
      "create": 0,
      "delete": 0
    }
  ]
}
