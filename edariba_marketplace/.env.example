# Copy to .env (git-ignored) or set as real environment variables / Frappe
# site_config.json keys on the server. NEVER commit real values here.
#
# QDRANT_URL confirmed live. One collection per entity type (2026-10-15
# decision) instead of the single shared "edariba_marketplace" collection
# used earlier — that one still exists, unused now, nothing writes to it.
# "accountants" already existed with 20 unrelated real records (different
# schema, no "status" field, integer ids) — reused anyway per explicit
# decision; query-safe since our status=Published filter excludes points
# that don't have that key. "services" and "projects" were newly created
# (1024-dim, Cosine) to match. Override any of the three below if needed.
QDRANT_URL=http://84.235.250.108:9080
QDRANT_COLLECTION_ACCOUNTANTS=accountants
QDRANT_COLLECTION_SERVICES=services
QDRANT_COLLECTION_PROJECTS=projects

# Verified live on 2026-10-14: POST {EMBEDDING_API_URL}/embed with header
# "Authorization: Bearer <key>" and body {"inputs": "<text>"} returns a bare
# JSON list of 1024-float vectors (HuggingFace TEI server).
EMBEDDING_API_URL=http://44.194.201.67:3778/embed
EMBEDDING_API_MODEL=bge-m3
EMBEDDING_API_KEY=__set_this_on_the_server_only__
