# Copy to .env (git-ignored) or set as real environment variables / Frappe
# site_config.json keys on the server. NEVER commit real values here.
#
# QDRANT_URL confirmed live. One collection per entity type, all prefixed
# "marketplace_" (2026-10-20) so they never mix with other collections on the
# same instance (e.g. the unrelated "accountants" records). Create them
# before first use: 1024-dim, Cosine (see README "Deploy"). Override any of
# the three below if needed.
QDRANT_URL=http://84.235.250.108:9080
QDRANT_COLLECTION_ACCOUNTANTS=marketplace_accountants
QDRANT_COLLECTION_SERVICES=marketplace_services
QDRANT_COLLECTION_PROJECTS=marketplace_projects

# Verified live on 2026-10-14: POST {EMBEDDING_API_URL}/embed with header
# "Authorization: Bearer <key>" and body {"inputs": "<text>"} returns a bare
# JSON list of 1024-float vectors (HuggingFace TEI server).
EMBEDDING_API_URL=http://44.194.201.67:3778/embed
EMBEDDING_API_MODEL=bge-m3
EMBEDDING_API_KEY=__set_this_on_the_server_only__

# Base URL used in request emails (links to {url}/marketplace/requests/<id>).
# Read from site_config.json key "marketplace_app_url"; defaults to https://app.edariba.com.
# marketplace_app_url=https://app.edariba.com
