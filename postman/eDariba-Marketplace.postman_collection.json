    {
      "name": "Search (needs EMBEDDING_API_KEY configured server-side)",
      "item": [
        {
          "name": "Unified semantic search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.public.search.search",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "edariba_marketplace.api.public.search.search"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"محتاج محاسب متخصص في الضرائب والفاتورة الإلكترونية في القاهرة\",\n  \"entity_types\": [\"accountant\", \"service\", \"project\"],\n  \"filters\": {\n    \"location\": \"القاهرة\",\n    \"specialty\": [\"الفاتورة الإلكترونية SDK\"]\n  },\n  \"page\": 1,\n  \"page_size\": 10\n}"
            }
          }
        },
        {
          "name": "Search with auto intent (former chat discovery)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.public.search.search",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "edariba_marketplace.api.public.search.search"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"عايز محاسب ضرائب في القاهرة\",\n  \"auto_intent\": 1,\n  \"filters\": {},\n  \"page\": 1,\n  \"page_size\": 10\n}"
            }
          }
        }
      ]
    },
