{
  "info": {
    "name": "eDariba Marketplace API",
    "description": "Marketplace endpoints in edariba_marketplace/api/. Set {{base_url}} to the site root, e.g. https://server.edariba.com. Public (Guest, read-only): Accountants/Services/Projects/Metadata/Search, and the Gateway that WordPress calls. Workspace (logged in): request flow used by app.edariba.com; log in first (the 'Login' request stores the sid cookie in Postman's cookie jar). Search needs EMBEDDING_API_KEY set in the server's site_config.json (never commit it).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "accountant_slug",
      "value": "hesham-elqadi"
    },
    {
      "key": "service_slug",
      "value": "monthly-bookkeeping-sme"
    },
    {
      "key": "project_slug",
      "value": "ecommerce-vat-cleanup"
    }
  ],
  "item": [
    {
      "name": "Accountants",
      "item": [
        {
          "name": "List accountants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.public.accountants.list_accountants?page=1&page_size=20&sort_by=experience_years&sort_order=desc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "edariba_marketplace.api.public.accountants.list_accountants"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                },
                {
                  "key": "sort_by",
                  "value": "experience_years"
                },
                {
                  "key": "sort_order",
                  "value": "desc"
                },
                {
                  "key": "q",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "specialty",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "governorate",
                  "value": "القاهرة",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get accountant by slug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.public.accountants.get_accountant?slug={{accountant_slug}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "edariba_marketplace.api.public.accountants.get_accountant"
              ],
              "query": [
                {
                  "key": "slug",
                  "value": "{{accountant_slug}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get accountant - not found (404 expected)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.public.accountants.get_accountant?slug=does-not-exist",
              "host": [
                "{{base_url}}"
