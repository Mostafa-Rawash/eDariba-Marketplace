    {
      "name": "Workspace (logged in; app.edariba.com request flow)",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/method/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"user@example.com\",\n  \"pwd\": \"<password>\"\n}"
            }
          }
        },
        {
          "name": "Submit request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.workspace.submit_request",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "edariba_marketplace.api.workspace.submit_request"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"<profile slug>\",\n  \"details\": \"محتاج مراجعة إقرار القيمة المضافة لشهر سبتمبر\",\n  \"inquiry_type\": \"consultation\",\n  \"related_service\": null,\n  \"phone\": null\n}"
            }
          }
        },
        {
          "name": "List sent requests",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.workspace.list_requests",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "edariba_marketplace.api.workspace.list_requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"box\": \"sent\",\n  \"page\": 1\n}"
            }
          }
        },
        {
          "name": "List received requests",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.workspace.list_requests",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "edariba_marketplace.api.workspace.list_requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"box\": \"received\",\n  \"status\": \"New\",\n  \"page\": 1\n}"
            }
          }
        },
        {
          "name": "Get request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.workspace.get_request",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "edariba_marketplace.api.workspace.get_request"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<request id>\"\n}"
            }
          }
        },
        {
          "name": "Respond to request (provider)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.workspace.respond_request",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "edariba_marketplace.api.workspace.respond_request"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<request id>\",\n  \"message\": \"أهلاً، يسعدني مساعدتك. أرسل لي آخر إقرار مقدّم.\"\n}"
            }
          }
        },
        {
          "name": "Set request status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/method/edariba_marketplace.api.workspace.set_request_status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "edariba_marketplace.api.workspace.set_request_status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<request id>\",\n  \"status\": \"Accepted\"\n}"
            }
          }
        },
        {
          "name": "Guest create via /api/resource (403 expected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/resource/Marketplace Inquiry",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "resource",
                "Marketplace Inquiry"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"<profile slug>\",\n  \"requester_name\": \"x\",\n  \"requester_email\": \"x@example.com\",\n  \"details\": \"x\"\n}"
            }
          }
        }
      ]
    },
