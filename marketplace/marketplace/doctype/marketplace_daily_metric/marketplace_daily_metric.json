{
  "doctype": "DocType",
  "name": "Marketplace Daily Metric",
  "module": "Marketplace",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "autoname": "hash",
  "track_changes": 0,
  "engine": "InnoDB",
  "description": "Daily counters per metric and record (services/events.py, upserted with SQL): profile_view, service_view (all views), search_impression, search_click (per result), search and search_no_result (site-wide, no reference). Kept after raw activity is purged.",
  "fields": [
    {
      "fieldname": "metric_key",
      "fieldtype": "Data",
      "label": "Metric Key",
      "unique": 1,
      "reqd": 1,
      "description": "hash(date|metric|doctype|name); the upsert key."
    },
    {
      "fieldname": "metric",
      "fieldtype": "Data",
      "label": "Metric",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "metric_date",
      "fieldtype": "Date",
      "label": "Date",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "reference_doctype",
      "fieldtype": "Link",
      "label": "Reference DocType",
      "options": "DocType"
    },
    {
      "fieldname": "reference_name",
      "fieldtype": "Data",
      "label": "Reference Name",
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "count",
      "fieldtype": "Int",
      "label": "Count",
      "default": "0",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 1
    },
    {
      "role": "Marketplace Moderator",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0
    }
  ]
}
