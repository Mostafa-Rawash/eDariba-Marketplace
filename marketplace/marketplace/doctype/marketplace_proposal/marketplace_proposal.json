{
  "doctype": "DocType",
  "name": "Marketplace Proposal",
  "module": "Marketplace",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "autoname": "hash",
  "naming_rule": "Random",
  "track_changes": 1,
  "engine": "InnoDB",
  "description": "ASSUMPTION / NOT YET IN THE WORDPRESS UI: project-detail.php's 'تقديم عرض على المشروع' button is an honest demo redirect to app.edariba with no proposal form on the public site today (data-edariba-demo-action). This DocType is still required because the product brief explicitly states freelancers submit proposals to projects (Mostaql-style) as one of the three core offerings, and app.edariba (not WordPress) is where that authenticated flow lives. Field set below is the minimum any such flow needs; confirm against the actual app.edariba form before building UI on top of it. Fully private: no Guest access anywhere.",
  "fields": [
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "options": "Marketplace Project",
      "label": "Project",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "freelancer",
      "fieldtype": "Link",
      "options": "Marketplace Profile",
      "label": "Freelancer",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "submitted_by",
      "fieldtype": "Link",
      "options": "User",
      "label": "Submitted By",
      "reqd": 1,
      "read_only": 1,
      "description": "Must equal freelancer.user; set automatically, not user-editable."
    },
    {
      "fieldname": "column_break_terms",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "proposed_amount",
      "fieldtype": "Currency",
      "label": "Proposed Amount",
      "reqd": 1,
      "non_negative": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "currency",
      "fieldtype": "Data",
      "label": "Currency",
      "default": "ج.م",
      "reqd": 1
    },
    {
      "fieldname": "estimated_days",
      "fieldtype": "Int",
      "label": "Estimated Days",
      "non_negative": 1
    },
    {
      "fieldname": "section_break_cover_letter",
      "fieldtype": "Section Break",
      "label": "Cover Letter"
    },
    {
      "fieldname": "cover_letter",
      "fieldtype": "Text Editor",
      "label": "Cover Letter",
      "reqd": 1
    },
    {
      "fieldname": "section_break_status",
      "fieldtype": "Section Break",
      "label": "Status"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "Submitted\nShortlisted\nAccepted\nRejected\nWithdrawn",
      "default": "Submitted",
      "label": "Status",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "submitted_at",
      "fieldtype": "Datetime",
      "label": "Submitted At",
      "read_only": 1
    },
    {
      "fieldname": "shortlisted_at",
      "fieldtype": "Datetime",
      "label": "Shortlisted At",
      "read_only": 1
    },
    {
      "fieldname": "accepted_at",
      "fieldtype": "Datetime",
      "label": "Accepted At",
      "read_only": 1
    },
    {
      "fieldname": "rejected_at",
      "fieldtype": "Datetime",
      "label": "Rejected At",
      "read_only": 1
    },
    {
      "fieldname": "withdrawn_at",
      "fieldtype": "Datetime",
      "label": "Withdrawn At",
      "read_only": 1,
      "description": "Lifecycle timestamps: set by the server the first time the proposal reaches the status, never overwritten (services/proposal_rules.py)."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Marketplace Moderator",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0
    },
    {
      "role": "Invoicing Owner",
      "permlevel": 0,
      "read": 1,
      "write": 0,
      "create": 1,
      "delete": 0
    }
  ]
}
